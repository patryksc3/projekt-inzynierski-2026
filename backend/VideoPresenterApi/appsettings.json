{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "VideoPresenterApi",
    "Audience": "VideoPresenterClient"
  },
  "DevicePairing": {
    "PairCodeLifetimeMinutes": 5
  },
  "MediaStorage": {
    "RootPath": "media-storage",
    "MaxFileSizeBytes": 524288000
  },
  "AllowedHosts": "*"
}
